# Cron-only Dockerfile — IDENTICAL to docker/Dockerfile except for the final CMD.
#
# Why this exists at all: the backend Dockerfile ends with
#   CMD ["sh", "-c", "uv run uvicorn backend.main:app ..."]
# Railway's `startCommand` override does NOT replace this form cleanly, so
# reusing the backend Dockerfile for the cron service caused every cron
# firing to silently start uvicorn instead of the ranking script.
#
# Keep this file in lockstep with docker/Dockerfile (everything above CMD).

ARG UV_VERSION=0.7.2
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM public.ecr.aws/docker/library/python:3.13-slim AS builder
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --group data

FROM public.ecr.aws/docker/library/python:3.13-slim AS runtime

RUN apt-get update -y && apt-get install -y curl postgresql-client && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

ENV PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY pyproject.toml uv.lock ./
COPY controller.py /app/
COPY backend /app/backend
COPY utils /app/utils
COPY templates /app/templates
COPY mcp_servers.json /app/mcp_servers.json
COPY .oauth_tokens /app/.oauth_tokens
COPY documents_index.json /app/documents_index.json
COPY documents /app/documents

ARG GIT_COMMIT
ENV GIT_COMMIT=$GIT_COMMIT

# THE entire reason for this file: a direct CMD that Railway runs verbatim.
CMD ["uv", "run", "python", "-m", "utils.ranking.run"]
