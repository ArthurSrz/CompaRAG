# Dedicated Dockerfile for the ranking-cron Railway service.
#
# The backend Dockerfile (docker/Dockerfile) ends with a uvicorn CMD that
# Railway's `startCommand` override in railway.cron.toml does NOT cleanly
# replace when the form is ["sh", "-c", "..."]. Reusing the backend image
# meant the cron container ran uvicorn instead of the ranking script —
# silent failure with cron-status=SUCCESS and no HF push.
#
# This image is identical to docker/Dockerfile up to runtime, but its CMD
# invokes the ranking script directly, so the start command is unambiguous.

ARG UV_VERSION=0.7.2
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM public.ecr.aws/docker/library/python:3.13-slim AS builder
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --group data

FROM public.ecr.aws/docker/library/python:3.13-slim AS runtime

RUN apt-get update -y && apt-get install -y curl postgresql-client && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

ENV PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY pyproject.toml uv.lock ./
COPY backend /app/backend
COPY utils /app/utils
COPY mcp_servers.json /app/mcp_servers.json

ARG GIT_COMMIT
ENV GIT_COMMIT=$GIT_COMMIT

# Cron entry point — single command, no shell wrapping, so Railway can
# inspect/override it cleanly if ever needed.
CMD ["uv", "run", "python", "-m", "utils.ranking.run"]
