export GOOGLE_APPLICATION_CREDENTIALS=comparia.json
export OPENROUTER_API_KEY=
export ALBERT_API_KEY=

export LOG_FORMAT="RAW" # en dev éviter les logs json

# S3
export AWS_SECRET_ACCESS_KEY=
export AWS_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net/
export AWS_ACCESS_KEY_ID=
export AWS_DEFAULT_REGION=gra

export HARBOR_USERNAME=""
export HARBOR_PASSWORD=""

# URL de votre serveur Jenkins
export JENKINS_URL=http://localhost:8080
# Nom d'utilisateur Jenkins
export JENKINS_USERNAME=admin
# Token API Jenkins (généré depuis Jenkins > [Votre utilisateur] > Configure > Add new Token)
export JENKINS_API_TOKEN=votre_token_api_ici
# Optionnel: Timeout de connexion en secondes
export JENKINS_TIMEOUT=30

# DEV
export COMPARIA_DB_URI="postgres://user:pass@host:20184/defaultdb?sslmode=require"

# Redis
export COMPARIA_REDIS_HOST=localhost

# needed to run the export_dataset.py script to upload to HF (let empty if you don't want to push)
export HF_PUSH_DATASET_KEY=""

# MOCK_RESPONSE=true

# Response caching (saves API costs by reusing past responses)
# CACHE_ENABLED=true
# CACHE_PROBABILITY=0.5        # 0.0-1.0: chance of serving cached response on hit
# CACHE_TTL=172800              # Cache lifetime in seconds (default 48h)
# CACHE_MAX_RESPONSES=5         # Max cached responses per (model, prompt) pair

export SENTRY_SAMPLE_RATE="1.0"
export SENTRY_ENV="dev"
export SENTRY_FRONT_DSN=""
export SENTRY_DSN=""

# Tool Arena — each MCP server runs its own full RAG pipeline (retrieval +
# generation). The langchain_rag and llamaindex_rag MCP servers read
# OPENROUTER_API_KEY (declared above) and call mistral-small via OpenRouter
# by default. Override the model per server via env vars:
#   export LANGCHAIN_RAG_LLM_ID=mistralai/mistral-small-3.1-24b-instruct
#   export LLAMAINDEX_RAG_LLM_ID=openrouter/mistralai/mistral-small-3.1-24b-instruct

# rag_pill — embeddings default to OPENROUTER_API_KEY against
# https://openrouter.ai/api/v1. If you see recurring "No embedding data
# received" errors (OpenRouter returning HTTP 200 with an empty data array),
# opt into a different provider for embeddings only — LLM calls keep using
# OpenRouter. EMBEDDING_BASE_URL switches the endpoint; the API key is taken
# from EMBEDDING_API_KEY, then OPENAI_API_KEY, then OPENROUTER_API_KEY.
# export EMBEDDING_BASE_URL=https://api.openai.com/v1
# export EMBEDDING_API_KEY=sk-...
# Bounded retry (default 2 retries) on the transient empty-data response:
# export RAG_PILL_EMBEDDING_RETRIES=2
